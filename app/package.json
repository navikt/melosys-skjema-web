{
  "name": "app",
  "type": "module",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "vite",
    "vite-mode": "VITE_BASE_PATH=/medlemskap-lovvalg/soknad/ vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "check-types": "tsc --noemit",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "generate-types": "swagger-typescript-api generate --path ${SWAGGER_BASE_URL:-https://melosys-skjema-api.intern.dev.nav.no}/v3/api-docs --output ./src/types --union-enums --no-client -n melosysSkjemaTypes",
    "sync-skjema-definisjon": "tsx scripts/sync-skjema-definisjon.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@navikt/aksel-icons": "8.17.2",
    "@navikt/ds-css": "8.17.2",
    "@navikt/ds-react": "8.17.2",
    "@navikt/ds-tailwind": "8.17.2",
    "@navikt/fnrvalidator": "^2.2.1",
    "@navikt/nav-dekoratoren-moduler": "4.5.0",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.104.0",
    "@tanstack/react-router": "1.170.40",
    "date-fns": "^4.4.0",
    "i18next": "26.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hook-form": "7.89.0",
    "react-i18next": "17.0.15",
    "tailwindcss": "^4.3.3",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.23.3",
    "@eslint/js": "10.0.1",
    "@navikt/aksel-stylelint": "8.18.0",
    "@playwright/test": "1.63.0",
    "@tanstack/router-vite-plugin": "1.167.42",
    "@types/node": "26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "baseline-browser-mapping": "^2.11.26",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.6",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "eslint-plugin-unicorn": "76.0.0",
    "globals": "17.13.0",
    "prettier": "3.9.9",
    "swagger-typescript-api": "13.13.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.2",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@10.33.1",
  "pnpm": {
    "overrides": {
      "undici": "^7.25.0"
    }
  }
}
