{
  "name": "app",
  "type": "module",
  "private": true,
  "version": "0.0.0",
  "scripts": {
    "dev": "vite",
    "vite-mode": "VITE_BASE_PATH=/medlemskap-lovvalg/soknad/ vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "check-types": "tsc --noemit",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "generate-types": "swagger-typescript-api generate --path ${SWAGGER_BASE_URL:-https://melosys-skjema-api.intern.dev.nav.no}/v3/api-docs --output ./src/types --union-enums --no-client -n melosysSkjemaTypes",
    "sync-skjema-definisjon": "tsx scripts/sync-skjema-definisjon.ts",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.1",
    "@navikt/aksel-icons": "8.19.2",
    "@navikt/ds-css": "8.19.2",
    "@navikt/ds-react": "8.19.2",
    "@navikt/ds-tailwind": "8.19.2",
    "@navikt/fnrvalidator": "^2.2.1",
    "@navikt/nav-dekoratoren-moduler": "4.5.1",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.104.3",
    "@tanstack/react-router": "1.170.44",
    "date-fns": "^4.4.0",
    "i18next": "26.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.90.0",
    "react-i18next": "17.0.17",
    "tailwindcss": "^4.3.3",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.27.2",
    "@eslint/js": "10.0.1",
    "@navikt/aksel-stylelint": "8.19.2",
    "@playwright/test": "1.64.1",
    "@tanstack/router-vite-plugin": "1.167.46",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "baseline-browser-mapping": "^2.11.28",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-simple-import-sort": "14.0.0",
    "eslint-plugin-unicorn": "78.0.0",
    "globals": "17.13.0",
    "prettier": "3.9.10",
    "swagger-typescript-api": "13.13.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@12.9.1"
}
